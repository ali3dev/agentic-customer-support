
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Configure a random API key (at least 32 characters) for the application.
# Example shape:
# AGENTIC_API_KEYS_JSON='{"<random-key>":{"tenant_id":"platform","role":"platform_admin"}}'
# Customer credentials also require a customer_id.
AGENTIC_API_KEYS_JSON=
AGENTIC_DATA_DIR=data
AGENTIC_KNOWLEDGE_BASE_DIR=data/tenant_knowledge_bases
AGENTIC_RATE_LIMIT_REQUESTS=60
AGENTIC_RATE_LIMIT_WINDOW_SECONDS=60
# Set for shared rate limits across hosts; Redis must be reachable at startup.
AGENTIC_RATE_LIMIT_REDIS_URL=
AGENTIC_RELEVANCE_THRESHOLD=0.6
